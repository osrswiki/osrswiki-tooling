# OSRS Wiki Monorepo .gitignore

# Root-level documentation and configuration
!.gitignore
!.gitattributes
!README.md
!CLAUDE.md
!USER.md
!AGENTS.md
!GEMINI.md
!package.json
!/*.md

# Allow directories and their contents  
!/platforms/
!/platforms/**
!/shared/
!/shared/**
!/tools/
!/tools/**
!/cloud/
!/cloud/**
!/scripts/
!/scripts/**
!/docs/
!/docs/**

# DevContainer configuration
!/.devcontainer/
!/.devcontainer/**
# But ignore runtime state
.devcontainer/claude-config/.claude/statsig/
.devcontainer/claude-config/.claude/shell-snapshots/
.devcontainer/claude-config/.claude/projects/
.devcontainer/tailscale-state/

# Claude configuration
!/.claude/
!/.claude/**
# But ignore session data
.claude/statsig/
.claude/shell-snapshots/

# Android-specific ignores
platforms/android/.gradle/
platforms/android/build/
platforms/android/app/build/
platforms/android/local.properties
platforms/android/.idea/
platforms/android/*.iml
platforms/android/.DS_Store
platforms/android/captures/
platforms/android/.externalNativeBuild/
platforms/android/.cxx/

# iOS-specific ignores  
platforms/ios/*.xcuserdata
platforms/ios/.build/
platforms/ios/DerivedData/
platforms/ios/build/
platforms/ios/*.hmap
platforms/ios/*.ipa
platforms/ios/*.dSYM.zip
platforms/ios/*.dSYM
*.xcresult/

# iOS test artifacts (should not be in platform root)
platforms/ios/ios-*.png
platforms/ios/debug_test.swift
platforms/ios/navigate_to_article.swift
platforms/ios/*test*.swift
platforms/ios/test_*.swift
platforms/ios/osrswiki/Resources/maps/img-*.png

# Tools and build artifacts
tools/css/output/
tools/tools/
tools/map/map-dumper/.gradle/
tools/map/openrs2_cache/
tools/map/map-dumper/build/
tools/map/map-dumper/output/
tools/map/map-dumper/jagexcache/
tools/environment/
tools/bin/
*.class

# Cache directories (moved to centralized cache)
# These directories may exist temporarily during migration
tools/map/openrs2_cache/
shared/assets/*.mbtiles

# Large binary assets (generated, not source-controlled)
# These files are generated by tools/map/map-asset-generator.py
# Available in development/worktrees but excluded from git
*.mbtiles
shared/assets/*.mbtiles
platforms/android/app/src/main/assets/img-*.png

# Legacy and machine-local artifact output
# Retain only small, reviewed provenance manifests in source control.
qa-evidence/
sessions/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# General
.DS_Store
__pycache__/
*.py[cod]
*.log
*.tmp
.env
.env.local

# Session files  
.ios-env
.ios-simulator-*
.simulator-lease.json
.osrs-artifacts.env
.claude-env
.claude-adb-server-port
.claude-device-*
.claude-app-id
.claude-emulator-name
.claude-session-device
.claude-bundle-id
.claude-session-simulator
.claude-simulator-*

# Screenshot management
screenshots/
screenshot*.png
test-screenshots/
*.screenshot.png
workflow_test_*.png
current_state.png
ui-dump.xml

# Temporary emulator files
emulator.err
emulator.out

# Google Drive temporary directories
.tmp.drivedownload/
.tmp.driveupload/
sessions/
# Pixi environments are materialized from tools/pixi.lock.
.pixi/

# Job scope records stay local to the checkout; never land them on main.
.agents/scope.json
