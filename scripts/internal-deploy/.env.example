# Copy to ~/.config/osrswiki/internal-deploy.env and fill in real local paths.
# Never commit populated env files, p8 keys, service-account JSON, keystores, or passwords.

# Optional override for config directory.
# OSRSWIKI_CONFIG_DIR=$HOME/.config/osrswiki

# Optional Python with google-api-python-client and google-auth installed.
# One-time setup example:
#   python3 -m venv $HOME/.config/osrswiki/internal-deploy-venv
#   $HOME/.config/osrswiki/internal-deploy-venv/bin/pip install google-api-python-client google-auth
# OSRSWIKI_INTERNAL_DEPLOY_PYTHON=$HOME/.config/osrswiki/internal-deploy-venv/bin/python3

# Android: Google Play internal testing.
# Closed testing (Alpha) is assigned automatically after a successful internal
# upload of the same versionCode. Do not set PLAY_TRACK=alpha or ask testers
# to join the internal opt-in; Xperia testers stay on the Alpha track.
PLAY_SERVICE_ACCOUNT_JSON=$HOME/.config/osrswiki/play-service-account.json
PLAY_TRACK=internal

# Android release signing.
# Normally use ~/.config/osrswiki/android-signing.properties.
# OSRSWIKI_ANDROID_SIGNING_PROPERTIES=$HOME/.config/osrswiki/android-signing.properties
# OSRSWIKI_ANDROID_KEYSTORE=$HOME/Documents/Develop/osrswiki/keys/android-keystore.jks
# OSRSWIKI_ANDROID_KEYSTORE_PASSWORD=REPLACE_WITH_KEYSTORE_PASSWORD
# OSRSWIKI_ANDROID_KEY_ALIAS=REPLACE_WITH_KEY_ALIAS
# OSRSWIKI_ANDROID_KEY_PASSWORD=REPLACE_WITH_KEY_PASSWORD

# iOS: TestFlight upload via App Store Connect API.
ASC_API_KEY_ID=REPLACE_WITH_ASC_API_KEY_ID
ASC_API_ISSUER_ID=REPLACE_WITH_ASC_ISSUER_UUID
ASC_API_KEY_PATH=$HOME/.config/osrswiki/AuthKey_REPLACE_WITH_KEY_ID.p8.template

# Optional Apple team ID.
# IOS_DEVELOPMENT_TEAM=8M2762LWD7
